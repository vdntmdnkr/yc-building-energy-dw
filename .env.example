# =============================================================================
# .env.example
# Copy this file to .env and configure for your local environment:
#   cp .env.example .env
# =============================================================================

# PostgreSQL Batch DW
PGHOST=localhost
PGPORT=5432
PGDATABASE=building_energy_dw
PGUSER=postgres
PGPASSWORD=postgres

# Citus Distributed DW
CITUS_HOST=localhost
CITUS_PORT=5433

# Kafka Streaming
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=building_energy_benchmarks

# ClickHouse Real-Time Store
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DATABASE=building_energy_rt
CLICKHOUSE_JDBC_URL=jdbc:clickhouse://localhost:8123/building_energy_rt

# Grafana Real-Time Dashboard
GRAFANA_URL=http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# NYC Open Data API (Optional Socrata token)
NYC_OPENDATA_APP_TOKEN=
NYC_OPENDATA_API_URL=https://data.cityofnewyork.us/resource/5zyy-y8am.csv
